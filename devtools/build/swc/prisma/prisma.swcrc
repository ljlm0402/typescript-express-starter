{
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": false,
      "decorators": true,
      "dynamicImport": true,
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "react": {
        "pragma": "React.createElement",
        "pragmaFrag": "React.Fragment",
      },
    },
    "target": "es2022",
    "externalHelpers": true,
    "keepClassNames": true,
    "loose": false,
    "minify": {
      "compress": {
        "dead_code": true,
        "drop_console": false,
        "drop_debugger": true,
        "keep_fargs": true,
        "pure_getters": false,
        "unused": true,
      },
      "mangle": false,
    },
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@config/*": ["config/*"],
      "@controllers/*": ["controllers/*"],
      "@dtos/*": ["dtos/*"],
      "@entities/*": ["entities/*"],
      "@exceptions/*": ["exceptions/*"],
      "@interfaces/*": ["interfaces/*"],
      "@middlewares/*": ["middlewares/*"],
      "@repositories/*": ["repositories/*"],
      "@routes/*": ["routes/*"],
      "@services/*": ["services/*"],
      "@utils/*": ["utils/*"],
    },
  },
  "module": {
    "type": "commonjs",
    "strict": true,
    "strictMode": true,
    "noInterop": false,
  },
  "exclude": [
    "node_modules",
    "dist",
    "prisma/migrations/**/*",
    "prisma/seed.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "coverage",
    "logs",
  ],
}
