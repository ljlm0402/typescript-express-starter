{
  "name": "mongoose-mongodb",
  "version": "1.0.0",
  "description": "mongoose ODM with MongoDB template",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "dev:watch": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "check": "tsc --noEmit",
    "db:generate": "echo 'No schema generation needed for MongoDB'",
    "db:migrate": "echo 'No migrations needed for MongoDB (schemaless)'",
    "db:migrate:create": "echo 'No migrations needed for MongoDB (schemaless)'",
    "db:migrate:rollback": "echo 'No migrations needed for MongoDB (schemaless)'",
    "db:seed": "tsx src/config/seed.ts",
    "db:studio": "echo 'Use MongoDB Compass or other MongoDB client'",
    "db:push": "echo 'No schema push needed for MongoDB'",
    "db:reset": "tsx src/config/reset.ts && npm run db:seed",
    "logs:clear": "rm -rf logs/*",
    "logs:view": "tail -f logs/combined.log"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.4",
    "morgan": "^1.10.1",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "pino-roll": "^3.1.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.0.0",
    "cross-env": "^10.0.0",
    "node-gyp": "^11.4.2",
    "nodemon": "^3.1.10",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
