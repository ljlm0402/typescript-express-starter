# ===========================================
# Default Template - Test Environment
# 테스트 환경 전용 설정 파일
# ===========================================

# Application Environment
# 애플리케이션 실행 환경 설정
NODE_ENV=test                          # 테스트 모드로 실행

# Test Logging
# 테스트 최적화 로깅 설정
LOG_FORMAT=dev                         # 개발 포맷 사용 (테스트 오류 추적 용이)

# Test-specific Settings
# 테스트 환경 전용 추가 설정
# PORT=0                               # 랜덤 포트 사용 (테스트 충돌 방지)
# LOG_LEVEL=silent                     # 테스트 실행 시 로그 출력 최소화
# TEST_TIMEOUT=10000                   # 테스트 타임아웃 (10초)
# JEST_VERBOSE=true                    # Jest 상세 출력 활성화
# SUPERTEST_AGENT=true                 # API 테스트를 위한 SuperTest 에이전트

# Test Database (if needed)
# 테스트 전용 데이터베이스 (필요시)
# TEST_DB_URL=                         # 테스트 전용 DB 연결 문자열
# RESET_DB_BEFORE_TESTS=true           # 테스트 전 DB 초기화
