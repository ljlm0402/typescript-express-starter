# ===========================================
# Default Template Environment Variables
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요
# ===========================================

# Application Settings
# 애플리케이션 기본 설정
PORT=3000                              # 서버 포트 번호

# JWT Authentication
# JWT 토큰 인증 설정
SECRET_KEY=yourSuperSecretKey-change-this-in-production  # JWT 서명용 비밀키 (프로덕션에서 변경 필수)

# Logging Configuration
# 로깅 시스템 설정
LOG_DIR=logs                           # 로그 파일 저장 디렉토리
LOG_LEVEL=info                         # 로그 레벨 (debug/info/warn/error)

# CORS Configuration
# Cross-Origin Resource Sharing 설정
ORIGIN=http://localhost:3000           # 기본 허용 도메인
CREDENTIALS=true                       # 쿠키 포함 요청 허용 여부
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com  # 허용할 도메인 목록 (쉼표 구분)

# External Services
# 외부 서비스 연결 설정
API_SERVER_URL=https://api.yourdomain.com  # API 서버 기본 URL

# Optional Services
# 선택적 서비스 설정 (필요시 활성화)
SENTRY_DSN=                            # Sentry 에러 트래킹 DSN (선택적)
REDIS_URL=redis://localhost:6379       # Redis 캐시 서버 URL (선택적)

# Additional Environment-specific Settings
# 추가 환경별 설정은 .env.{NODE_ENV}.local 파일을 사용하세요
# Example: .env.development.local, .env.production.local, .env.test.local