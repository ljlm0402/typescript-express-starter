# ===========================================
# Default Template - Development Environment
# 개발환경 전용 설정 파일
# ===========================================

# Application Environment
# 애플리케이션 실행 환경 설정
NODE_ENV=development                   # 개발 모드로 실행

# Development Logging
# 개발환경 최적화 로깅 설정
LOG_FORMAT=dev                         # 개발자 친화적 로그 포맷 (컬러풀, 상세한 정보)

# Development-specific Settings
# 개발환경 전용 추가 설정 (필요시 추가)
# DEBUG=*                              # 디버그 모든 모듈 활성화 (선택적)
# LOG_LEVEL=debug                      # 상세 디버그 로깅 (선택적)
# HOT_RELOAD=true                      # 핫 리로드 활성화 (선택적)
