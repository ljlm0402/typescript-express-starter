# ===========================================
# Default Template - Production Environment
# 프로덕션 환경 전용 설정 파일
# ===========================================

# Application Environment
# 애플리케이션 실행 환경 설정
NODE_ENV=production                    # 프로덕션 모드로 실행

# Production Logging
# 프로덕션 최적화 로깅 설정
LOG_FORMAT=combined                    # 표준 Apache 로그 포맷 (성능 최적화)

# Production-specific Settings
# 프로덕션 환경 전용 추가 설정 (필요시 활성화)
# LOG_LEVEL=warn                       # 경고 이상만 로깅하여 성능 향상
# COMPRESSION=true                     # 응답 압축 활성화
# TRUST_PROXY=true                     # 리버스 프록시 환경 지원
# SESSION_SECURE=true                  # HTTPS 전용 세션 쿠키
# RATE_LIMIT_ENABLED=true              # API 요청 제한 활성화

# Security Headers (프로덕션 보안 강화)
# HELMET_CSP=true                      # Content Security Policy 활성화
# HELMET_HSTS=true                     # HTTP Strict Transport Security
