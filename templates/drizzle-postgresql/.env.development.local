# ===========================================
# Development Environment Configuration
# 개발 환경 전용 설정
# ===========================================

# APP
NODE_ENV=development

# Database (Development)
DATABASE_URL="postgresql://postgres:password@localhost:5432/drizzle_db_dev"
POSTGRES_DB=drizzle_db_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Server Settings
PORT=3000

# Logging (Development)
LOG_FORMAT=dev
LOG_LEVEL=debug

# CORS (Development - 더 관대한 설정)
ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CREDENTIALS=true

# Development Tools
DEBUG=app:*
WATCH_MODE=true