# ===========================================
# Drizzle PostgreSQL Environment Template
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요
# ===========================================

# Application Environment
# 애플리케이션 실행 환경 설정
NODE_ENV=development                   # 실행 환경: development/production/test
PORT=3000                              # 서버 포트 번호

# JWT Authentication Settings
# JWT 인증 토큰 관련 설정
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production  # JWT 서명 비밀키 (필수 변경)
JWT_EXPIRES_IN=24h                     # 토큰 만료 시간

# Logging Configuration
# 로깅 시스템 설정
LOG_LEVEL=debug                        # 로그 레벨 (debug/info/warn/error)

# Database Configuration (PostgreSQL)
# PostgreSQL 데이터베이스 연결 설정
DATABASE_URL=postgresql://postgres:password@postgres:5432/drizzle_postgresql_dev  # 전체 연결 문자열

# Individual Database Settings (선택적)
DB_NAME=drizzle_postgresql_dev         # 데이터베이스 이름
DB_USER=postgres                       # 데이터베이스 사용자명
DB_PASSWORD=password                   # 데이터베이스 비밀번호
DB_PORT=5432                           # 데이터베이스 포트

# Docker Compose Configuration
# Docker 컨테이너 설정
COMPOSE_PROJECT_NAME=drizzle_postgresql  # Docker Compose 프로젝트 이름

# Development Tools (Optional)
# 개발 도구 설정 (선택사항)
PGADMIN_EMAIL=admin@example.com        # pgAdmin 관리자 이메일
PGADMIN_PASSWORD=admin                 # pgAdmin 관리자 비밀번호
PGADMIN_PORT=5050                      # pgAdmin 웹 포트
REDIS_PORT=6379                        # Redis 포트 (캐시용, 선택적)
