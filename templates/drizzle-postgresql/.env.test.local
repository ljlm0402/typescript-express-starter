# ===========================================
# Test Environment Configuration
# 테스트 환경 전용 설정
# ===========================================

# APP
NODE_ENV=test

# Database (Test) - 별도 테스트 DB 사용
DATABASE_URL="postgresql://postgres:password@localhost:5432/drizzle_db_test"
POSTGRES_DB=drizzle_db_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Server Settings
PORT=0  # 랜덤 포트 사용 (테스트 충돌 방지)

# JWT (Test) - 간단한 설정
JWT_SECRET="test-jwt-secret-key"
SECRET_KEY="test-secret-key"
JWT_EXPIRES_IN="1h"

# Logging (Test) - 최소한의 로그
LOG_FORMAT=dev
LOG_LEVEL=silent

# CORS (Test)
ORIGIN=*
CREDENTIALS=true

# Test Specific Settings
TEST_TIMEOUT=10000
DB_RESET_BETWEEN_TESTS=true

# Performance (Test)
NODE_OPTIONS="--max-old-space-size=1024"

# Disable External Services in Tests
DISABLE_LOGGING=true
DISABLE_METRICS=true