# ===========================================
# Drizzle PostgreSQL Default Configuration
# 기본 개발 환경 설정 파일
# ===========================================

# Database Configuration
# PostgreSQL 연결 정보 (로컬 개발용)
DATABASE_URL="postgresql://postgres:password@localhost:5432/drizzle_db"

# Docker PostgreSQL Configuration
# Docker Compose PostgreSQL 컨테이너 설정
POSTGRES_DB=drizzle_db                 # 생성할 데이터베이스 이름
POSTGRES_USER=postgres                 # PostgreSQL 사용자명
POSTGRES_PASSWORD=password             # PostgreSQL 비밀번호
COMPOSE_PROJECT_NAME=drizzle-postgres  # Docker Compose 프로젝트 이름

# JWT Authentication
# JWT 토큰 인증 관련 설정
SECRET_KEY="your-secret-key"           # JWT 서명용 비밀키 (프로덕션에서 변경 필수)
JWT_SECRET="your-secret-key"           # JWT 토큰 생성용 비밀키
JWT_EXPIRES_IN="24h"                   # 토큰 만료 시간 (24시간)

# Server Configuration
# 서버 기본 설정
PORT=3000                              # 서버 포트 (기본 3000)
NODE_ENV=development                   # 실행 환경 (development/production/test)

# Logging Configuration
# 로깅 시스템 설정
LOG_DIR=logs                           # 로그 파일 저장 디렉토리
LOG_LEVEL=info                         # 로그 레벨 (debug/info/warn/error)

# CORS Configuration
# Cross-Origin Resource Sharing 설정
ORIGIN=http://localhost:3000           # 허용할 프론트엔드 도메인
CREDENTIALS=true                       # 쿠키 포함 요청 허용 여부
